&i2c0 {
    status = "okay";
    sda-pin = <17>;
    scl-pin = <20>;
    clock-frequency = <I2C_BITRATE_FAST>;

    tca9548a: tca9548a@70 {
        compatible = "ti,tca9548a";
        reg = <0x70>;
        #address-cells = <1>;
        #size-cells = <0>;

        i2c@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;

            key0: pca9557@0x20 { compatible = "nxp,pca9557"; reg = <0x0x20>; gpio-controller; #gpio-cells = <2>; };
            key1: pca9557@0x21 { compatible = "nxp,pca9557"; reg = <0x0x21>; gpio-controller; #gpio-cells = <2>; };
            key2: pca9557@0x22 { compatible = "nxp,pca9557"; reg = <0x0x22>; gpio-controller; #gpio-cells = <2>; };
            key3: pca9557@0x23 { compatible = "nxp,pca9557"; reg = <0x0x23>; gpio-controller; #gpio-cells = <2>; };
        };

        i2c@1 {
            reg = <1>;
            #address-cells = <1>;
            #size-cells = <0>;

            key4: pca9557@0x20 { compatible = "nxp,pca9557"; reg = <0x0x20>; gpio-controller; #gpio-cells = <2>; };
            key5: pca9557@0x21 { compatible = "nxp,pca9557"; reg = <0x0x21>; gpio-controller; #gpio-cells = <2>; };
            key6: pca9557@0x22 { compatible = "nxp,pca9557"; reg = <0x0x22>; gpio-controller; #gpio-cells = <2>; };
            key7: pca9557@0x23 { compatible = "nxp,pca9557"; reg = <0x0x23>; gpio-controller; #gpio-cells = <2>; };
        };

        i2c@2 {
            reg = <2>;
            #address-cells = <1>;
            #size-cells = <0>;

            key8: pca9557@0x20 { compatible = "nxp,pca9557"; reg = <0x0x20>; gpio-controller; #gpio-cells = <2>; };
            key9: pca9557@0x21 { compatible = "nxp,pca9557"; reg = <0x0x21>; gpio-controller; #gpio-cells = <2>; };
            key10: pca9557@0x22 { compatible = "nxp,pca9557"; reg = <0x0x22>; gpio-controller; #gpio-cells = <2>; };
            key11: pca9557@0x23 { compatible = "nxp,pca9557"; reg = <0x0x23>; gpio-controller; #gpio-cells = <2>; };
        };

        i2c@demo {
            reg = <demo>;
            #address-cells = <1>;
            #size-cells = <0>;

            key12: pca9557@demo_1793926115980 { compatible = "nxp,pca9557"; reg = <0xdemo_1793926115980>; gpio-controller; #gpio-cells = <2>; };
        };

    };
};

/ {
    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios =
            <&key0 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key1 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key2 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key3 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key4 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key5 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key6 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key7 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key8 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key9 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key10 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key11 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
            <&key12 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };

    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
        label = "CDC_ACM_0";
    };
};
